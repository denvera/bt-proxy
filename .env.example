# ESPHome Bluetooth proxy - Docker Environment Configuration for docker-compose.yml
# https://github.com/denvera/bt-proxy
# Copy this file to .env. Every option is optional, the values below are the defaults.

### Docker image (optional):
# BT_PROXY_IMAGE="ghcr.io/denvera/bt-proxy"
# BT_PROXY_IMAGE_TAG="latest"

### Name (optional):
# Name of the device in mDNS and the API, and the name shown in Home Assistant. Left unset the device name
# follows the linux-voice-assistant with BLE at the end, lva-<mac>-ble, and the friendly name is "BT-Proxy - <mac> BLE"
# (MAC address without colons).
# BT_PROXY_NAME="lva-001122334455-ble"
# BT_PROXY_FRIENDLY_NAME="BT-Proxy - 001122334455 BLE"

### Unblock Bluetooth (optional):
# A fresh install has the Bluetooth adapter soft-blocked by rfkill, and the proxy cannot start the scanner then. When
# true, the container unblocks it on start (through /dev/rfkill) and powers the adapter on. The unblock is kept by
# systemd-rfkill on the host, also after a reboot. Set to false to leave the state of the adapter alone.
# BT_PROXY_RFKILL_UNBLOCK="true"

### Port of the API (optional):
# 6053 is the port of the linux-voice-assistant on the same host, so the proxy uses 6054 by default.
# Home Assistant finds the proxy over mDNS and takes the port from there.
# BT_PROXY_PORT="6054"

### Maximum number of concurrent BLE GATT connections (optional):
# BT_PROXY_MAX_CONNECTIONS="3"

### Log level (optional):
# DEBUG, INFO, WARNING, ERROR
# BT_PROXY_LOG_LEVEL="INFO"
