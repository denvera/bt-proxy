[Unit]
Description=Bluetooth Proxy (ESPHome-compatible)
# BlueZ must be up before we talk to the adapter over D-Bus; the network must be
# up for mDNS discovery. (Kept in sync with deploy/bt-proxy.service.)
After=bluetooth.target network-online.target dbus.service
Wants=bluetooth.target network-online.target
Requires=dbus.service

[Service]
Type=simple
WorkingDirectory=/opt/bt-proxy
# Optional runtime config in /etc/bt-proxy/bt-proxy.env (the same path the
# deploy/install.sh installer uses). The leading "-" means the unit still starts
# if the file is absent, so unencrypted/backwards-compatible operation keeps
# working. Put in that file:
#   BT_PROXY_ENCRYPTION_KEY=<base64 key>       # openssl rand -base64 32; use the
#                                              # SAME key in Home Assistant
#   BT_PROXY_NAME=living-room-proxy
#   BT_PROXY_FRIENDLY_NAME=Living Room Proxy    # may contain spaces
# Set name/friendly-name via these variables, NOT as command-line args: systemd
# word-splits an expanded arg string on whitespace, breaking a multi-word name.
# Without a key the proxy still starts, but runs UNENCRYPTED (deprecated).
EnvironmentFile=-/etc/bt-proxy/bt-proxy.env
# This unit runs the app via `uv`. On a Raspberry Pi Zero (ARMv6) uv has no
# build -- use deploy/install.sh + deploy/bt-proxy.service (a plain venv) there.
ExecStart=uv run python -m bt_proxy --log-level INFO
Restart=on-failure
RestartSec=10
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
