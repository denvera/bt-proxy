[Unit]
Description=Bluetooth Proxy (ESPHome-compatible)
After=network-online.target bluetooth.service dbus.service
Wants=network-online.target bluetooth.service

[Service]
Type=simple
WorkingDirectory=/opt/bt-proxy
ExecStart=/opt/bt-proxy/.venv/bin/python -m bt_proxy --log-level INFO
Restart=on-failure
RestartSec=10
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
